
name: Swing & Options Recommendations

on:
  # Run twice per trading weekday
  schedule:
    - cron: '37 16,19 * * 1-5'

  workflow_dispatch:
    inputs:
      test_alert:
        description: 'Telegram connectivity only; no market data'
        type: boolean
        required: false
        default: false

      preview:
        description: 'Print potential ideas in Actions logs; do not notify or save state'
        type: boolean
        required: false
        default: false

permissions:
  contents: read

concurrency:
  group: swing-options-recommendations
  cancel-in-progress: false

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 18

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Recover prior alerts and virtual swing exits
        uses: actions/cache@v4
        with:
          path: swing_options_state.json
          key: swing-options-state-${{ github.run_id }}-${{ github.run_attempt }}
          restore-keys: |
            swing-options-state-

      - name: Dependencies
        run: python -m pip install 'requests>=2.31,<3' 'pandas>=2.1,<3' 'exchange_calendars>=4.5,<5'

      - name: Scan stock swing ideas and optional call/put contracts
        env:
          ALPACA_API_KEY: ${{ secrets.ALPACA_API_KEY }}
          ALPACA_SECRET_KEY: ${{ secrets.ALPACA_SECRET_KEY }}
          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
          TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
          DATA_FEED: iex
          OPTIONS_FEED: indicative
          MAX_OPTION_SPREAD: '0.12'
          MAX_OPTION_ASK: '35'
          WATCHLIST: 'SPY,QQQ,IWM,DIA,NVDA,TSLA,AMD,AMZN,PLTR,HOOD,AAPL,MSFT,META,GOOGL,AVGO,MU,SMCI,CRWD,COIN,MSTR,NFLX,SOFI,SHOP,UBER'

        shell: bash
        run: |
          if [[ '${{ inputs.test_alert }}' == 'true' ]]; then
            python swing_options_agent.py --test-alert
          elif [[ '${{ inputs.preview }}' == 'true' ]]; then
            python swing_options_agent.py --preview
          else
            python swing_options_agent.py --once
          fi
